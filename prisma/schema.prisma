generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                          String              @id @default(cuid())
  name                        String?
  email                       String              @unique
  emailVerified               DateTime?
  image                       String?
  password                    String?
  role                        Role                @default(EDITOR)
  active                      Boolean             @default(true)
  phone                       String?
  bio                         String?
  twoFactorEnabled            Boolean             @default(false)
  twoFactorSecret             String?
  lastLoginAt                 DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  accounts                    Account[]
  auditLogs                   AuditLog[]
  assignedInquiries           Inquiry[]           @relation("InquiryAssignee")
  assignedInternshipInquiries InternshipInquiry[] @relation("InternshipInquiryAssignee")
  uploadedMedia               Media[]             @relation("MediaUploader")
  notes                       Note[]              @relation("NoteAuthor")
  sessions                    Session[]
  assignedTripInquiries       TripInquiry[]       @relation("TripInquiryAssignee")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Media {
  id           String   @id @default(cuid())
  name         String
  url          String
  alt          String?
  title        String?
  description  String?
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  uploader     User?    @relation("MediaUploader", fields: [uploadedById], references: [id])

  @@index([uploadedById])
  @@index([mimeType])
  @@index([createdAt])
}

model ServiceCategory {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  description    String
  icon           String        @default("Building2")
  image          String?
  cta            String        @default("Talk to an Accountant")
  seoTitle       String?
  seoDescription String?
  displayOrder   Int           @default(0)
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  services       Service[]

  @@index([status])
  @@index([displayOrder])
}

model Service {
  id               String           @id @default(cuid())
  categoryId       String
  name             String
  slug             String
  description      String
  shortDescription String?
  icon             String           @default("Briefcase")
  image            String?
  ctaLabel         String           @default("Request a Consultation")
  ctaUrl           String           @default("/contact")
  seoTitle         String?
  seoDescription   String?
  featured         Boolean          @default(false)
  displayOrder     Int              @default(0)
  status           ContentStatus    @default(PUBLISHED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  category         ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  benefits         ServiceBenefit[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([status])
  @@index([featured])
}

model ServiceBenefit {
  id           String  @id @default(cuid())
  serviceId    String
  text         String
  displayOrder Int     @default(0)
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model TeamMember {
  id           String        @id @default(cuid())
  name         String
  role         String
  bio          String?
  photo        String?
  email        String?
  linkedin     String?
  expertise    String        @default("[]")
  isFounder    Boolean       @default(false)
  displayOrder Int           @default(0)
  status       ContentStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([displayOrder])
}

model Industry {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String
  icon         String        @default("Building2")
  image        String?
  services     String        @default("[]")
  displayOrder Int           @default(0)
  status       ContentStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([displayOrder])
}

model FaqItem {
  id           String        @id @default(cuid())
  question     String
  answer       String
  category     String        @default("General")
  displayOrder Int           @default(0)
  status       ContentStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([category])
  @@index([displayOrder])
}

model Destination {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  shortDescription String?
  description      String        @default("")
  image            String?
  galleryImages    String?
  displayOrder     Int           @default(0)
  featured         Boolean       @default(false)
  status           ContentStatus @default(PUBLISHED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  category         String?
  location         String?
  seoDescription   String?
  seoTitle         String?

  @@index([status])
  @@index([featured])
  @@index([displayOrder])
}

model TourPackage {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  location       String?
  duration       String?
  price          String?
  priceNote      String?
  overview       String        @default("")
  facts          String?
  highlights     String?
  itinerary      String?
  inclusions     String?
  exclusions     String?
  note           String?
  image          String?
  galleryImages  String?
  featured       Boolean       @default(false)
  displayOrder   Int           @default(0)
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  category       String?
  seoDescription String?
  seoTitle       String?

  @@index([status])
  @@index([featured])
  @@index([displayOrder])
}

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @default("")
  content        String        @default("")
  category       String        @default("Travel Guides")
  image          String?
  author         String        @default("Global Line Safaris")
  readTime       Int?
  seoTitle       String?
  seoDescription String?
  featured       Boolean       @default(false)
  displayOrder   Int           @default(0)
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([category])
  @@index([featured])
  @@index([createdAt])
}

model TripInquiry {
  id               String        @id @default(cuid())
  name             String
  email            String
  phone            String?
  travelDate       String?
  duration         String?
  travelers        String?
  preferredPackage String?
  budget           String?
  destination      String?
  message          String?
  status           InquiryStatus @default(NEW)
  read             Boolean       @default(false)
  archived         Boolean       @default(false)
  assignedToId     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  country          String?
  assignedTo       User?         @relation("TripInquiryAssignee", fields: [assignedToId], references: [id])

  @@index([email])
  @@index([status])
  @@index([archived])
  @@index([createdAt])
  @@index([assignedToId])
}

model InternshipInquiry {
  id                 String        @id @default(cuid())
  name               String
  email              String
  phone              String?
  university         String?
  fieldOfStudy       String?
  programType        String?
  preferredStartDate String?
  duration           String?
  areasOfInterest    String?
  message            String?
  status             InquiryStatus @default(NEW)
  read               Boolean       @default(false)
  archived           Boolean       @default(false)
  assignedToId       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  country            String?
  experience         String?
  assignedTo         User?         @relation("InternshipInquiryAssignee", fields: [assignedToId], references: [id])

  @@index([email])
  @@index([status])
  @@index([archived])
  @@index([createdAt])
  @@index([assignedToId])
}

model HomepageSection {
  id          String   @id @default(cuid())
  sectionKey  String   @unique
  eyebrow     String?
  title       String?
  subtitle    String?
  description String?
  items       String?
  imageKey    String?
  ctaLabel    String?
  ctaUrl      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteImage {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  alt       String?
  mediaId   String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model SeoSetting {
  id           String   @id @default(cuid())
  pageKey      String   @unique
  title        String?
  description  String?
  ogImage      String?
  canonicalUrl String?
  indexable    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Inquiry {
  id           String        @id @default(cuid())
  name         String
  email        String
  phone        String?
  company      String?
  service      String?
  message      String
  source       String        @default("contact")
  status       InquiryStatus @default(NEW)
  read         Boolean       @default(false)
  archived     Boolean       @default(false)
  assignedToId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assignedTo   User?         @relation("InquiryAssignee", fields: [assignedToId], references: [id])

  @@index([email])
  @@index([status])
  @@index([archived])
  @@index([createdAt])
  @@index([assignedToId])
}

model Note {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  authorId   String?
  body       String
  createdAt  DateTime @default(now())
  author     User?    @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([targetType, targetId])
  @@index([authorId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  type      String   @default("inquiry")
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum ContentStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  QUALIFIED
  CONVERTED
  CLOSED
  SPAM
}
