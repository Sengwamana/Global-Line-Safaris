# Database (PostgreSQL — Neon)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?sslmode=require&channel_binding=require"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxx"

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# Vercel Blob Storage (optional — preferred if set)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxx"

# Cloudflare R2 Storage (optional — free 10 GB, zero egress; used when Blob is unset)
# Create an R2 bucket + API token at https://dash.cloudflare.com → R2.
# Enable public access on the bucket and set R2_PUBLIC_URL to its public base URL
# (an r2.dev URL like https://pub-xxxxxxxx.r2.dev, or a custom domain).
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="global-line-safaris-media"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# Cron (optional)
CRON_SECRET="your-cron-secret"
